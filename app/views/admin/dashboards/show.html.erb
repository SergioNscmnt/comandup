<% room = @metrics[:table_dashboard] %>
<% tables_entry_order_id = room[:tables].find { |table| table[:order_id].present? }&.dig(:order_id) %>
<% commands_entry_order_id = tables_entry_order_id %>
<% menu_entry_order_id = tables_entry_order_id %>
<div class="container-fluid admin-dashboard-container py-4 py-lg-5">
  <section class="maitre-dashboard fade-in-up">
    <aside class="maitre-sidebar">
      <div class="maitre-brand">
        <strong>Comand Up</strong>
        <span><%= l(Time.current, format: "%H:%M") %> • <%= l(Time.current.to_date, format: "%A") %></span>
      </div>

      <nav class="maitre-nav">
        <%= link_to admin_dashboard_path, class: "maitre-nav__link is-active" do %>
          <%= ui_icon(:grid) %>
          <span>Dashboard</span>
        <% end %>
        <%= link_to(tables_entry_order_id.present? ? checkout_admin_order_path(tables_entry_order_id) : admin_dashboard_path(table_state: "occupied"), class: "maitre-nav__link") do %>
          <%= ui_icon(:list) %>
          <span>Mesas</span>
        <% end %>
        <%= link_to(commands_entry_order_id.present? ? admin_order_path(commands_entry_order_id) : admin_queue_path, class: "maitre-nav__link") do %>
          <%= ui_icon(:receipt) %>
          <span>Comandas</span>
        <% end %>
        <%= link_to(menu_entry_order_id.present? ? menu_admin_order_path(menu_entry_order_id) : products_path, class: "maitre-nav__link") do %>
          <%= ui_icon(:box) %>
          <span>Menu</span>
        <% end %>
        <%= link_to finance_admin_dashboard_path(@screen_query.except(:table_state)), class: "maitre-nav__link" do %>
          <%= ui_icon(:chart) %>
          <span>Relatórios</span>
        <% end %>
      </nav>

      <div class="maitre-sidebar__cta">
        <%= link_to products_path, class: "btn btn-brand icon-btn justify-content-center" do %>
          <%= ui_icon(:plus) %>
          <span>Nova Comanda</span>
        <% end %>
      </div>

      <div class="maitre-sidebar__footer">
        <span><%= ui_icon(:user) %> Support</span>
        <%= button_to admin_logout_path, method: :delete, class: "maitre-sidebar__logout" do %>
          <%= ui_icon(:logout) %>
          <span>Logout</span>
        <% end %>
      </div>
    </aside>

    <div class="maitre-main">
      <header class="maitre-topbar">
        <nav class="maitre-topbar__tabs">
          <span class="is-active">Board</span>
          <span>Mesas</span>
          <span>Comandas</span>
        </nav>
        <div class="maitre-topbar__actions">
          <button type="button" class="maitre-icon-btn" aria-label="Notificações"><%= ui_icon(:bell) %></button>
          <button type="button" class="maitre-icon-btn" aria-label="Configurações"><%= ui_icon(:gear) %></button>
          <span class="maitre-avatar"><%= ui_icon(:user) %></span>
        </div>
      </header>

      <section class="maitre-overview">
        <div class="maitre-overview__head">
          <div>
            <h1>Status das Mesas</h1>
            <p class="text-secondary mb-0">Visão viva da operação de salão e da fila da cozinha.</p>
          </div>
          <div class="maitre-filters">
            <% room[:filters].each do |filter| %>
              <%= link_to admin_dashboard_path(@screen_query.merge(table_state: filter[:key])), class: "maitre-filter #{'is-active' if room[:selected_state] == filter[:key]}" do %>
                <span><%= filter[:label] %></span>
              <% end %>
            <% end %>
          </div>
        </div>

        <section class="maitre-summary">
          <article class="maitre-stat">
            <small>Ocupação atual</small>
            <strong><%= room.dig(:totals, :occupied_tables) %> <span>/ <%= room.dig(:totals, :total_tables) %> mesas</span></strong>
          </article>
          <article class="maitre-stat">
            <small>Tempo médio</small>
            <strong><%= dashboard_minutes_label(room.dig(:totals, :average_minutes)) %></strong>
          </article>
          <article class="maitre-stat">
            <small>Total em aberto</small>
            <strong><%= money(room.dig(:totals, :total_open_cents)) %></strong>
          </article>
          <article class="maitre-stat">
            <small>Tickets pendentes</small>
            <strong><%= format("%02d", room.dig(:totals, :pending_tickets).to_i) %></strong>
          </article>
        </section>

        <section class="maitre-grid">
          <% room[:tables].each do |table| %>
            <article class="table-status-card <%= dashboard_table_state_class(table[:state]) %> <%= 'is-clickable' if table[:occupied] && table[:order_id].present? %>">
              <div class="table-status-card__top">
                <div>
                  <h2><%= format("%02d", table[:number]) %></h2>
                </div>
                <div class="table-status-card__meta">
                  <span><%= table[:state_label] %></span>
                  <% if table[:occupied] %>
                    <small><%= ui_icon(:clock) %> <%= table[:elapsed_label] %></small>
                  <% end %>
                </div>
              </div>

              <% if table[:occupied] %>
                <div class="table-status-card__body">
                  <small>Consumo atual</small>
                  <strong><%= money(table[:current_total_cents]) %></strong>
                  <p><%= table[:summary] %></p>
                  <% if table[:note].present? %>
                    <span class="table-status-card__note"><%= table[:note] %></span>
                  <% end %>
                  <% if table[:order_id].present? %>
                    <span class="table-status-card__cta">
                      <span>Fechar mesa</span>
                      <%= ui_icon(:receipt) %>
                    </span>
                  <% end %>
                </div>
              <% else %>
                <div class="table-status-card__empty">
                  <%= link_to products_path, class: "table-status-card__action" do %>
                    <%= ui_icon(:plus) %>
                    <span><%= table[:action_label] %></span>
                  <% end %>
                </div>
              <% end %>

              <% if table[:occupied] && table[:order_id].present? %>
                <%= link_to checkout_admin_order_path(table[:order_id]), class: "table-status-card__cover", "aria-label": "Abrir fechamento da #{format('Mesa %02d', table[:number])}" do %>
                  <span class="visually-hidden">Abrir fechamento da mesa</span>
                <% end %>
              <% end %>
            </article>
          <% end %>

          <article class="kitchen-queue-card">
            <div class="kitchen-queue-card__head">
              <h2><%= ui_icon(:utensils) %> Fila da Cozinha</h2>
              <strong><%= dashboard_minutes_label(room.dig(:kitchen, :average_wait_minutes)) %> de espera</strong>
            </div>
            <dl class="kitchen-queue-card__stats">
              <div>
                <dt>Entradas</dt>
                <dd><%= format("%02d", room.dig(:kitchen, :received_count).to_i) %> pendentes</dd>
              </div>
              <div>
                <dt>Pratos principais</dt>
                <dd><%= format("%02d", room.dig(:kitchen, :in_production_count).to_i) %> pendentes</dd>
              </div>
              <div>
                <dt>Prontos para servir</dt>
                <dd><%= format("%02d", room.dig(:kitchen, :ready_count).to_i) %> tickets</dd>
              </div>
            </dl>
          </article>
        </section>
      </section>
    </div>
  </section>
</div>
